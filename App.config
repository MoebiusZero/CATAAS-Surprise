<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Microsoft 365 app registration (Entra ID > App registrations > your app > Overview) -->
    <add key="TenantId" value="e3b0b2c9-03c7-4e9f-a390-2e67cff89b76"/>
    <add key="ClientId" value="34fdeea4-3348-4677-a0cf-19453908563d"/>
    <!-- Leave empty and set the CATAAS_CLIENT_SECRET environment variable instead, so the secret never ends up in git -->
    <add key="ClientSecret" value=""/>
    <!-- Mailbox the email is sent from, must be a licensed mailbox or shared mailbox in your tenant -->
    <add key="FromEmail" value="cataas@cslim.nl"/>
    <!-- Where error reports are sent when something goes wrong -->
    <add key="ErrorEmail" value="cookingwithasianfriend@cslim.nl"/>
  </appSettings>
</configuration>
